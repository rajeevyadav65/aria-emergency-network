{
  "info": {
    "name": "ARIA Emergency Network API",
    "description": "Complete ARIA Emergency Network API \u2014 v2.0 with AI, Offline Sync, Disaster Alerts, Medical Services, Voice Trigger",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "authToken",
      "value": ""
    },
    {
      "key": "deviceId",
      "value": "postman-test-device-001"
    },
    {
      "key": "emergencyId",
      "value": "1"
    },
    {
      "key": "sessionId",
      "value": "postman-test-device-001"
    }
  ],
  "item": [
    {
      "name": "\ud83d\udd10 Authentication",
      "item": [
        {
          "name": "Register New User",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/register",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test User\",\n  \"email\": \"test@example.com\",\n  \"password\": \"test1234\",\n  \"deviceId\": \"{{deviceId}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const json = pm.response.json();",
                  "  pm.collectionVariables.set('authToken', json.token);",
                  "  pm.test('Token received', () => pm.expect(json.token).to.be.a('string'));",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login (Demo: Alice)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/login",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"alice@demo.com\",\n  \"password\": \"demo123\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const json = pm.response.json();",
                  "  pm.collectionVariables.set('authToken', json.token);",
                  "  pm.collectionVariables.set('deviceId', json.deviceId);",
                  "  pm.test('Login successful', () => pm.expect(json.token).to.be.a('string'));",
                  "  console.log('Token saved:', json.token.substring(0, 20) + '...');",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login (Admin)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/login",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@aria.com\",\n  \"password\": \"admin123\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  pm.collectionVariables.set('authToken', pm.response.json().token);",
                  "  pm.test('Admin login OK', () => pm.expect(pm.response.json().role).to.eql('ADMIN'));",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Guest Session",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/auth/guest?deviceId={{deviceId}}",
              "query": [
                {
                  "key": "deviceId",
                  "value": "{{deviceId}}"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Guest token received', () => {",
                  "  pm.expect(pm.response.json().role).to.eql('GUEST');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "\ud83d\udea8 Emergency",
      "item": [
        {
          "name": "Report Emergency (HIGH - Needs Help)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/emergency/report",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"I fell down the stairs and can't get up\",\n  \"latitude\": 27.1767,\n  \"longitude\": 78.0081,\n  \"fallDetected\": true,\n  \"movement\": \"STATIONARY\",\n  \"userResponse\": \"NEED_HELP\",\n  \"deviceId\": \"{{deviceId}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HIGH risk emergency created', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.riskLevel).to.eql('HIGH');",
                  "  pm.collectionVariables.set('emergencyId', json.emergencyId);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Report Emergency (FALSE ALARM - User OK)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/emergency/report",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"Accidental trigger\",\n  \"latitude\": 27.1767,\n  \"longitude\": 78.0081,\n  \"fallDetected\": false,\n  \"movement\": \"WALKING\",\n  \"userResponse\": \"ARE_YOU_OK\",\n  \"deviceId\": \"{{deviceId}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Correctly classified as FALSE_ALARM', () => {",
                  "  pm.expect(pm.response.json().status).to.eql('FALSE_ALARM');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Report Emergency (MEDIUM - Fall + Moving)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/emergency/report",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"Possible fall, still moving\",\n  \"latitude\": 27.1800,\n  \"longitude\": 78.0100,\n  \"fallDetected\": true,\n  \"movement\": \"WALKING\",\n  \"userResponse\": \"NO_RESPONSE\",\n  \"deviceId\": \"{{deviceId}}\"\n}"
            }
          }
        },
        {
          "name": "Get Emergency by ID",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/emergency/{{emergencyId}}",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ]
          }
        },
        {
          "name": "Get All Emergencies",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/emergency/all",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ]
          }
        },
        {
          "name": "Get Active Emergencies",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/emergency/active",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ]
          }
        },
        {
          "name": "Resolve Emergency",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/api/emergency/{{emergencyId}}/resolve",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Emergency resolved', () => {",
                  "  pm.expect(pm.response.json().status).to.eql('RESOLVED');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "\ud83d\udcac AI Chat (ARIA)",
      "item": [
        {
          "name": "Send Chat Message",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/chat/message",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sessionId\": \"{{sessionId}}\",\n  \"message\": \"I need help, I fell down\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Chat reply received', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.reply).to.be.a('string');",
                  "  pm.expect(json.sessionId).to.exist;",
                  "  console.log('Is Emergency:', json.isEmergency);",
                  "  console.log('Reply:', json.reply.substring(0, 100));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Chat History",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/chat/history?sessionId={{sessionId}}",
              "query": [
                {
                  "key": "sessionId",
                  "value": "{{sessionId}}"
                }
              ]
            }
          }
        },
        {
          "name": "Clear Chat History",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/api/chat/clear?sessionId={{sessionId}}",
              "query": [
                {
                  "key": "sessionId",
                  "value": "{{sessionId}}"
                }
              ]
            }
          }
        }
      ]
