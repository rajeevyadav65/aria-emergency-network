# Copy this file to .env and fill in your values
# Usage: source .env && mvn spring-boot:run

# Anthropic Claude API key (get from https://console.anthropic.com)
# Optional — app works without it using rule-based fallback
ANTHROPIC_API_KEY=sk-ant-your-key-here

# JWT secret — use a strong random string (min 32 chars)
JWT_SECRET=aria-emergency-network-super-secret-change-me

# Server port (default 8080)
# SERVER_PORT=8080
