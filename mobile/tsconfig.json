{
  "extends": "@react-native/typescript-config/tsconfig.json",
  "compilerOptions": {
    "jsx": "react-native",
    "baseUrl": ".",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "paths": {
      "@screens/*":    ["src/screens/*"],
      "@services/*":   ["src/services/*"],
      "@utils/*":      ["src/utils/*"],
      "@components/*": ["src/components/*"]
    }
  }
}
